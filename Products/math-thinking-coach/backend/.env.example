APP_NAME=Math Thinking Coach API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Directory for persisted app data (runtime.db, JSON stores). Local dev
# default is fine as-is; deployments with a mounted persistent disk (e.g.
# Render) must point this at the mount path - see docs/Deployment-Guide.md.
DATA_DIR=app/data

# Session cookie signing key (Starlette SessionMiddleware). MUST be changed
# to a real random secret outside local development - see
# docs/Deployment-Guide.md before deploying anywhere.
SESSION_SECRET_KEY=dev-only-insecure-secret-change-me

# Comma-separated list of origins allowed to call this API with credentials.
# Local dev default is the Vite dev server; a deployed frontend's real
# origin must be added here (see docs/Deployment-Guide.md).
ALLOWED_ORIGINS=http://localhost:5173

# Set to true only when served over HTTPS - see docs/Deployment-Guide.md.
SESSION_HTTPS_ONLY=false

# Shadow Mode (ADR-002): an experimental AI evaluator that calls a local
# Ollama instance out-of-band, logging-only, never affecting the response.
# Set to false wherever no local Ollama server is running (e.g. most
# deployments) to avoid a background timeout on every answer submission.
SHADOW_MODE_ENABLED=true
SHADOW_OLLAMA_URL=http://localhost:11434/api/generate
SHADOW_TIMEOUT_SECONDS=90
SHADOW_MODEL_NAME=qwen2.5:7b-instruct
SHADOW_LOG_PATH=app/data/shadow_log/shadow_eval_log.jsonl
